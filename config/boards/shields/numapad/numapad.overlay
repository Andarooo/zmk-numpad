#include <dt-bindings/zmk/matrix_transform.h>
/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
    };

    default_kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        col-gpios
            = <&pro_micro 8 GPIO_ACTIVE_HIGH>
            , <&pro_micro 9 GPIO_ACTIVE_HIGH>
            , <&pro_micro 21 GPIO_ACTIVE_HIGH>
            , <&pro_micro 20 GPIO_ACTIVE_HIGH>
            ;

        row-gpios
            = <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <4>; // Length of the "col-gpios" array
        rows = <6>; // Length of the "row-gpios" array
        map = <
        //   Key 1 | Key 2 
            RC(0,0) RC(0,1) 
        //   Key 3 | Key 4 | Key 5 | Key 6
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
        //   Key 7 | Key 8 | Key 9 
            RC(2,0) RC(2,1) RC(2,2) 
        //   Key 10| Key 11| Key 12| Key 13
            RC(3,0) RC(3,1) RC(3,2) RC(3,3)
        //   Key 14| Key 15| Key 16| Key 17
            RC(4,0) RC(4,1) RC(4,2)
        //   Key 18| Key 19| Key 20
            RC(5,0) RC(5,2) RC(5,3)
        >;
    };

    physical_layout0: physical_layout_ { // First physical layout, use different naming for other layouts
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&default_kscan>; // Label of the kscan node, optional if all layouts use the same
        transform = <&default_transform>; // Label of the matrix transform for this layout
    };
};
