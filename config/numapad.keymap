#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
//|  m1  |  m2  |
//|  num |  /   |  *   |  -   |
//|  7   |  8   |  9   |
//|  4   |  5   |  6   |  +   |
//|  1   |  2   |  3   |
//|      0      |  .   |  enter|
            bindings = <
                &kp HOME &kp END 
                &kp LNLCK &kp SLASH &kp ASTRK &kp MINUS
                &kp N7 &kp N8 &kp N9
                &kp N4 &kp N5 &kp N6 &kp PLUS
                &kp N1 &kp N2 &kp N3
                &kp N0 &kp PERIOD &kp ENTER
            >;
        };
    };
};